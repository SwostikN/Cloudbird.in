# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form enquiries are delivered.
CONTACT_TO_EMAIL=Support@cloudbird.in

# Who they appear to come from. Must be on a domain verified in Resend
# (https://resend.com/domains). Until cloudbird.in is verified you can use
# "Cloud Bird India <onboarding@resend.dev>", which only delivers to the
# Resend account owner's own address.
CONTACT_FROM_EMAIL=Cloud Bird India <noreply@cloudbird.in>
